+    private func rewriteBackgroundTaskIdentifiers(
+        in infoDictionary: inout [String: Any],
+        from originalBundleIdentifier: String,
+        to finalBundleIdentifier: String
+    ) {
+        guard originalBundleIdentifier != finalBundleIdentifier,
+              !originalBundleIdentifier.isEmpty,
+              let identifiers = infoDictionary["BGTaskSchedulerPermittedIdentifiers"] as? [String]
+        else {
+            return
+        }
+
+        let childPrefix = originalBundleIdentifier + "."
+        infoDictionary["BGTaskSchedulerPermittedIdentifiers"] = identifiers.map { identifier in
+            guard identifier == originalBundleIdentifier || identifier.hasPrefix(childPrefix) else {
+                return identifier
+            }
+
+            let suffix = identifier.dropFirst(originalBundleIdentifier.count)
+            return finalBundleIdentifier + String(suffix)
+        }
+    }
     
